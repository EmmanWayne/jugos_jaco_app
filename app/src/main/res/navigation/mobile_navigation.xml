<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_clientes">

    <!-- SalesFragment -->
    <fragment
        android:id="@+id/nav_ventas"
        android:name="com.jugos_jaco_app.ui.sales.SalesFragment"
        android:label="@string/menu_home"
        tools:layout="@layout/fragment_sales">

        <!-- Acción para navegar a NewSaleFragment -->
        <action
            android:id="@+id/action_nav_ventas_to_newSaleFragment"
            app:destination="@id/newSaleFragment" />
            
        <!-- Acción para navegar a SaleDetailFragment -->
        <action
            android:id="@+id/action_nav_ventas_to_saleDetailFragment"
            app:destination="@id/saleDetailFragment" />
    </fragment>
    
    <!-- SaleDetailFragment -->
    <fragment
        android:id="@+id/saleDetailFragment"
        android:name="com.jugos_jaco_app.ui.sales.SaleDetailFragment"
        android:label="Detalle de Venta"
        tools:layout="@layout/fragment_sale_detail" />

    <!-- GalleryFragment -->
    <fragment
        android:id="@+id/nav_clientes"
        android:name="com.jugos_jaco_app.ui.clients.ClientsFragment"
        android:label="@string/clients"
        tools:layout="@layout/fragment_clients">

        <!-- Acción para navegar a NuevoClienteFragment -->
        <action
            android:id="@+id/action_to_newClienteFragment"
            app:destination="@id/newClientFragment" />
    </fragment>

    <!-- SlideshowFragment -->
    <fragment
        android:id="@+id/nav_slideshow"
        android:name="com.jugos_jaco_app.ui.slideshow.SlideshowFragment"
        android:label="@string/menu_slideshow"
        tools:layout="@layout/fragment_slideshow" />

    <!-- NuevoClienteFragment -->


    <fragment
        android:id="@+id/clientDetailsFragment"
        android:name="com.jugos_jaco_app.ui.clients.ClientDetailsFragment"
        android:label="Detalles del Cliente"
        tools:layout="@layout/fragment_client_details">

        <argument
            android:name="firstName"
            app:argType="string" />
        <argument
            android:name="lastName"
            app:argType="string" />
        <argument
            android:name="phoneNumber"
            app:argType="string" />
        <argument
            android:name="adress"
            app:argType="string" />
        <argument
            android:name="department"
            app:argType="string" />
        <argument
            android:name="township"
            app:argType="string" />

        <argument
            android:name="business_name"
            app:argType="string" />
        <argument
            android:name="latitude"
            app:argType="string"
          />
        <argument
            android:name="longitude"
            app:argType="string"
              />

        <action
            android:id="@+id/action_gallery_to_clientDetailsFragment"
            app:destination="@id/clientDetailsFragment" />

        <action
            android:id="@+id/action_clientDetailsFragment_to_newClientFragment"
            app:destination="@id/newClientFragment"
             />

        <action
            android:id="@+id/action_clientDetailsFragment_to_editClientFragment"
            app:destination="@id/editClientFragment"
            />

        <action
            android:id="@+id/action_clientDetailsFragment_to_newSaleFragment"
            app:destination="@id/newSaleFragment" />
    </fragment>

    <fragment
        android:id="@+id/newClientFragment"
        android:name="com.jugos_jaco_app.ui.clients.NewClientFragment"
        android:label="Nuevo Cliente"
        tools:layout="@layout/fragment_new_client" />

    <fragment
        android:id="@+id/editClientFragment"
        android:name="com.jugos_jaco_app.ui.clients.EditClientFragment"
        android:label="Editar Cliente"
        tools:layout="@layout/fragment_edit_client">
        
        <action
            android:id="@+id/action_editClientFragment_to_clientsFragment"
            app:destination="@id/nav_clientes"
            app:popUpTo="@id/nav_clientes"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/newSaleFragment"
        android:name="com.jugos_jaco_app.ui.sales.NewSaleFragment"
        android:label="Nueva Venta"
        tools:layout="@layout/fragment_new_sale">
        
        <argument
            android:name="client_id"
            app:argType="string" />
        <argument
            android:name="client_name"
            app:argType="string" />
    </fragment>

    <!-- En el fragment de clientes -->
    <action
        android:id="@+id/action_nav_clientes_to_newSaleFragment"
        app:destination="@id/newSaleFragment" />

    <fragment
        android:id="@+id/nav_accounts_receivable"
        android:name="com.jugos_jaco_app.ui.accounts.AccountsReceivableFragment"
        android:label="Cuentas por Cobrar"
        tools:layout="@layout/fragment_accounts_receivable">
        
        <action
            android:id="@+id/action_accountsReceivableFragment_to_accountReceivableDetailFragment"
            app:destination="@id/accountReceivableDetailFragment" />
            
    </fragment>

    <fragment
        android:id="@+id/accountReceivableDetailFragment"
        android:name="com.jugos_jaco_app.ui.accounts_receivable.AccountReceivableDetailFragment"
        android:label="Detalle de Cuenta por Cobrar"
        tools:layout="@layout/fragment_account_receivable_detail">
        
        <argument
            android:name="account_id"
            app:argType="integer" />

        <action
            android:id="@+id/action_accountReceivableDetailFragment_to_saleDetailFragment"
            app:destination="@id/saleDetailFragment" />
            
    </fragment>

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.jugos_jaco_app.ui.employee.EmployeeProfileFragment"
        android:label="Mi Perfil"
        tools:layout="@layout/fragment_employee_profile" />

    <fragment
        android:id="@+id/productsAssignedFragment"
        android:name="com.jugos_jaco_app.ui.products.ProductsAssignedFragment"
        android:label="Productos Asignados"
        tools:layout="@layout/fragment_products_assigned">
        
        <!-- Acción para navegar a NewSaleFragment -->
        <action
            android:id="@+id/action_productsAssignedFragment_to_newSaleFragment"
            app:destination="@id/newSaleFragment" />
    </fragment>

</navigation>